#!/bin/bash
# Bootstrap one immutable Hamn release selected by GitHub's latest asset URL.
set -euo pipefail
export LC_ALL=C
# Keep the caller PATH only for setup advice; installation uses system tools.
caller_path=${PATH:-}
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

readonly HAMN_VERSION=__HAMN_VERSION__
readonly HAMN_COMMIT=__HAMN_COMMIT__
readonly HAMN_HOST_URL=__HAMN_HOST_URL__
readonly HAMN_HOST_SHA256=__HAMN_HOST_SHA256__
readonly HAMN_GUEST_URL=__HAMN_GUEST_URL__
readonly HAMN_GUEST_SHA256=__HAMN_GUEST_SHA256__
readonly HAMN_HOST_SIZE=__HAMN_HOST_SIZE__
readonly HAMN_GUEST_SIZE=__HAMN_GUEST_SIZE__

fail() {
    echo "hamn install: $*" >&2
    exit 1
}

sha256_file() {
    shasum -a 256 "$1" | awk '{print $1}'
}

safe_regular() {
    local path=$1
    [ -f "$path" ] && [ ! -L "$path" ] || return 1
    [ "$(stat -f '%u:%l' "$path")" = "$(id -u):1" ]
}

if [ "$#" -gt 0 ]; then
    if [ "$#" = 1 ] && { [ "$1" = --help ] || [ "$1" = -h ]; }; then
        echo "Install Hamn ${HAMN_VERSION#v} for Apple Silicon macOS."
        echo "Usage: bash install.sh"
        echo "Downloads and verifies the host archive and guest image, then installs to ~/.local/bin."
        echo "Existing VMs are not restarted; existing profile disks keep their guest root."
        echo "For updates: hamn upgrade (or hamn --headless system update --yes)"
        exit 0
    fi
    fail "unknown arguments; use bash install.sh --help"
fi

[ -n "${HOME:-}" ] || fail "HOME is not set"
[[ "$HAMN_VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    fail "embedded release version is invalid"
[[ "$HAMN_COMMIT" =~ ^[0-9a-f]{40}$ ]] || fail "embedded release commit is invalid"
[[ "$HAMN_HOST_SHA256" =~ ^[0-9a-f]{64}$ ]] || fail "embedded host digest is invalid"
[[ "$HAMN_GUEST_SHA256" =~ ^[0-9a-f]{64}$ ]] || fail "embedded guest digest is invalid"
# Reject foreign commands before creating cache state or downloading anything.
# The verified updater performs the complete generation ownership check again.
if [ -e "$HOME/.local/bin/hamn" ] && [ ! -L "$HOME/.local/bin/hamn" ]; then
    fail "existing hamn is not a managed generation; migrate it with make install before using the release installer"
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/hamn-install.XXXXXX") ||
    fail "cannot create installer workspace"
cleanup() {
    rm -rf "$work"
}
trap cleanup EXIT

echo "hamn install: Preparing Hamn ${HAMN_VERSION#v}" >&2
cat >"$work/upgrade_support.py" <<'HAMN_EMBEDDED_UPGRADE_SUPPORT'
__HAMN_UPGRADE_SUPPORT__
HAMN_EMBEDDED_UPGRADE_SUPPORT
chmod 0600 "$work/upgrade_support.py"
python3 - "$work/bootstrap.json" "$HAMN_VERSION" "$HAMN_COMMIT" "$HAMN_HOST_URL" \
    "$HAMN_HOST_SHA256" "$HAMN_HOST_SIZE" "$HAMN_GUEST_URL" "$HAMN_GUEST_SHA256" "$HAMN_GUEST_SIZE" <<'PY_BOOTSTRAP'
import json, sys
path, version, commit, host, host_hash, host_size, guest, guest_hash, guest_size = sys.argv[1:]
value = {"schemaVersion":3,"channel":"stable","version":version,"commit":commit,
    "validationMode":"github-hosted-no-vm",
    "compatibility":{"os":"darwin","architecture":"arm64","minimumMacOS":"13.0"},
    "artifacts":{"host":{"url":host,"sha256":host_hash,"size":int(host_size)},
    "guestImage":{"url":guest,"sha256":guest_hash,"size":int(guest_size),"format":"qcow2","compression":"zlib","virtualSize":8*1024**3}}}
with open(path,"w") as output: json.dump(value,output)
PY_BOOTSTRAP
# Bootstrap embeds the exact shared acquisition implementation so repeated
# installers obey the same digest lock, resume and byte validation contract.
python3 - "$work" "$HOME" <<'PY_CACHE'
import sys
sys.path.insert(0, sys.argv[1])
from upgrade_support import cache_root
cache_root(sys.argv[2])
PY_CACHE
echo "hamn install: Downloading host archive..." >&2
host_archive=$(HAMN_UPDATE_ALLOW_LOCAL_ARTIFACTS=${HAMN_INSTALL_ALLOW_LOCAL_ARTIFACTS:-0} \
    python3 "$work/upgrade_support.py" acquire "$work/bootstrap.json" host \
    "$HOME/.hamn/cache" "$work/host-counts.json") || fail "host download failed; check your connection and rerun this installer"
echo "hamn install: Verifying host archive SHA-256..." >&2
[ "$(sha256_file "$host_archive")" = "$HAMN_HOST_SHA256" ] ||
    fail "host artifact SHA-256 mismatch"

artifact_root=$(python3 - "$host_archive" "$work/extract" <<'PY'
import os
import posixpath
import sys
import tarfile

archive, destination = sys.argv[1:]
with tarfile.open(archive, "r:gz") as bundle:
    members = bundle.getmembers()
    if not members:
        raise SystemExit("empty host artifact")
    roots = set()
    for member in members:
        name = member.name
        if name.startswith("/") or "\\" in name:
            raise SystemExit("unsafe host artifact path")
        normalized = posixpath.normpath(name)
        if normalized in (".", "..") or normalized.startswith("../") or normalized != name.rstrip("/"):
            raise SystemExit("unsafe host artifact path")
        roots.add(normalized.split("/", 1)[0])
        if not (member.isdir() or member.isreg()):
            raise SystemExit("host artifact contains a non-regular entry")
    if len(roots) != 1:
        raise SystemExit("host artifact must have one top-level directory")
    root = next(iter(roots))
    required = {
        root + "/bin/hamn",
        root + "/scripts/install-host.sh",
        root + "/scripts/update-host.sh",
        root + "/packaging/release/update-manifest-url",
    }
    actual = {member.name.rstrip("/") for member in members}
    if not required.issubset(actual):
        raise SystemExit("host artifact is missing required Hamn files")
    os.makedirs(destination, mode=0o700, exist_ok=True)
    for member in members:
        bundle.extract(member, destination)
print(root)
PY
) || fail "host artifact validation or extraction failed"
artifact=$work/extract/$artifact_root
[ -x "$artifact/bin/hamn" ] && [ -x "$artifact/scripts/update-host.sh" ] ||
    fail "verified host artifact is incomplete"

manifest=$work/manifest.json
python3 - "$manifest" "$HAMN_VERSION" "$HAMN_COMMIT" "$host_archive" \
    "$HAMN_HOST_SHA256" "$HAMN_GUEST_URL" "$HAMN_GUEST_SHA256" "$HAMN_HOST_SIZE" "$HAMN_GUEST_SIZE" <<'PY'
import json
import sys

path, version, commit, host, host_hash, guest, guest_hash, host_size, guest_size = sys.argv[1:]
value = {
    "schemaVersion": 3,
    "channel": "stable",
    "version": version,
    "commit": commit,
    "validationMode": "github-hosted-no-vm",
    "compatibility": {
        "os": "darwin",
        "architecture": "arm64",
        "minimumMacOS": "13.0",
    },
    "artifacts": {
        "host": {"url": "file://" + host, "sha256": host_hash, "size": int(host_size)},
        "guestImage": {"url": guest, "sha256": guest_hash, "size": int(guest_size),
                       "format": "qcow2", "compression": "zlib", "virtualSize": 8 * 1024 ** 3},
    },
}
with open(path, "w", encoding="utf-8", newline="\n") as output:
    json.dump(value, output, sort_keys=True, separators=(",", ":"))
    output.write("\n")
PY
env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    HAMN_UPDATE_ALLOW_LOCAL_ARTIFACTS=1 \
    /bin/bash "$artifact/scripts/update-host.sh" --bootstrap \
    --bindir "$HOME/.local/bin" --datadir "$HOME/.local/share/hamn/src" \
    --manifest "file://$manifest"

# Resolve the command using the caller's search order without executing it.
# PATH membership alone misses an earlier Homebrew or legacy hamn executable.
resolved_command=$(PATH="$caller_path" command -v hamn || :)
if [ -n "$resolved_command" ] && python3 - "$resolved_command" "$HOME/.local/bin/hamn" <<'PY_PATH'
import os
import sys
try:
    sys.exit(0 if os.path.samefile(sys.argv[1], sys.argv[2]) else 1)
except OSError:
    sys.exit(1)
PY_PATH
then
    echo "hamn install: Ready. Run hamn to open the terminal interface." >&2
else
    if [ -n "$resolved_command" ]; then
        printf 'hamn install: PATH currently selects another hamn: %s\n' "$resolved_command" >&2
    else
        echo "hamn install: hamn is not on your current PATH." >&2
    fi
    printf 'hamn install: Installed command: %s\n' "$HOME/.local/bin/hamn" >&2
    echo "hamn install: Add this to your shell configuration, then open a new terminal:" >&2
    echo '  export PATH="$HOME/.local/bin:$PATH"' >&2
fi
